# Copia este archivo a ".env" (mismo nombre, sin ".example") y ajusta los
# valores. ".env" nunca debería subirse a un repositorio compartido si en
# algún momento defines SECRETO_COOKIES con un valor real de producción.

# Obligatorio en producción: firma las cookies de sesión. Genera algo largo
# y aleatorio, ej. con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRETO_COOKIES=

# Carpeta donde se guarda la base de datos SQLite (artonseley.db).
# En local puedes dejarla vacía (usa ./data). EN PRODUCCIÓN (Render) es
# OBLIGATORIA y debe apuntar a la ruta de montaje de un disco persistente
# —ej. /var/data—, o TODOS los datos (usuarios, licencias, leyes) se
# borran en cada despliegue. Ver README, "Despliegue en Render".
CARPETA_DATOS=

# Actívalo (=1) cuando haya un proxy/balanceador delante de la app, como
# en Render. Ver el comentario en servidor/config.js.
CONFIA_EN_PROXY=

# Opcionales — ver README para su valor por defecto si los dejas vacíos.
DIAS_DURACION_SESION=
LIMITE_INTENTOS_LOGIN=
MINUTOS_BLOQUEO_LOGIN=
PORT=
NODE_ENV=

# Recordatorios del calendario (notificaciones Web Push). Genera el par
# UNA vez con:  npm run generar-vapid   y pega aquí los dos valores.
# Si los dejas vacíos, la función queda desactivada (el sitio arranca igual).
VAPID_PUBLICA=
VAPID_PRIVADA=
# Contacto que el servicio de push usa para avisos (un mailto: o una URL).
VAPID_SUBJECT=mailto:soporte@artonseley.site

# Solo si el hosting duerme el proceso (Render Free): un token secreto para
# que un cron externo (cron-job.org, etc.) dispare el envío diario pegando a
# POST /api/tareas/recordatorios con la cabecera "Authorization: Bearer <token>".
# Vacío = esa ruta no existe (404).
TOKEN_TAREAS=
